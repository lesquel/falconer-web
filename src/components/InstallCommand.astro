---
/** One-line command with a copy button (see scripts/interactions.ts). Defaults to the hook installer. */
const INSTALL = 'curl -fsSL https://raw.githubusercontent.com/lesquel/falconer-hook/main/install.sh | sh';

interface Props {
  command?: string;
  label?: string;
}

const { command = INSTALL, label = 'Copiar el comando de instalación' } = Astro.props;
---

<button type="button" class="install mono" data-copy={command} aria-label={label}>
  <code><span aria-hidden="true">$</span> {command}</code>
  <span class="state" data-copy-state aria-live="polite">copiar</span>
</button>

<style>
  .install {
    max-width: 100%;
    display: flex;
    gap: 14px;
    align-items: center;
    font-size: 14px;
    color: var(--fg);
    background: var(--raised);
    border: 1px solid var(--line-strong);
    padding: 14px 16px;
    border-radius: 14px;
    cursor: pointer;
    text-align: left;
  }
  code { overflow-x: auto; scrollbar-width: none; white-space: nowrap; min-width: 0; font: inherit; }
  code::-webkit-scrollbar { display: none; }
  code span { color: var(--accent); }
  .state { color: var(--muted); font-size: 13px; flex: none; }
  .install:hover { border-color: var(--accent); }
</style>
