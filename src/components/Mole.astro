---
/** The OpenMosh mole. With `watch`, its pupils follow the pointer (see scripts/pointer.ts). */
interface Props {
  size?: number;
  watch?: boolean;
  label?: string;
}

const { size = 190, watch = false, label = 'El Topo de OpenMosh' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label={label}
  data-mole={watch ? '' : undefined}
>
  <ellipse cx="100" cy="190" rx="70" ry="12" fill="#000"></ellipse>
  <path d="M48 190 Q44 104 74 78 Q100 60 126 78 Q156 104 152 190z" fill="var(--mole)"></path>
  <path d="M62 190 Q60 120 82 98 Q100 86 118 98 Q140 120 138 190z" fill="var(--mole-light)"></path>
  <rect x="58" y="86" width="84" height="10" rx="5" fill="#0a0a0a"></rect>
  <circle cx="82" cy="94" r="16" fill="#0a0a0a"></circle>
  <circle cx="118" cy="94" r="16" fill="#0a0a0a"></circle>
  <circle cx="82" cy="94" r="11" fill="var(--accent)"></circle>
  <circle cx="118" cy="94" r="11" fill="var(--accent)"></circle>
  <g data-pupils>
    <circle cx="82" cy="94" r="4.2" fill="#0a0a0a"></circle>
    <circle cx="118" cy="94" r="4.2" fill="#0a0a0a"></circle>
  </g>
  <ellipse cx="100" cy="122" rx="14" ry="10" fill="var(--snout)"></ellipse>
  <path d="M86 124 L68 120 M86 128 L68 132 M114 124 L132 120 M114 128 L132 132" stroke="#2b2018" stroke-width="2" stroke-linecap="round"></path>
  <path d="M52 150 Q36 146 30 156 Q38 166 54 164z" fill="var(--snout)"></path>
  <path d="M148 150 Q164 146 170 156 Q162 166 146 164z" fill="var(--snout)"></path>
</svg>
