---
import Base from '../../layouts/Base.astro';
---

<Base lang="en" title="Open OpenMosh" description="Opens the OpenMosh app.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  </Fragment>

  <main class="wrap open">
    <p class="eyebrow">openmosh / notifications</p>
    <h1 class="section-title" id="msg">Opening OpenMosh…</h1>
    <a class="btn primary big" id="open" href="#" hidden>Open OpenMosh</a>
  </main>

  <script>
    import { targetFromSearch } from '../../scripts/webpush';

    const to = targetFromSearch(location.search);
    const btn = document.getElementById('open') as HTMLAnchorElement;
    const msg = document.getElementById('msg') as HTMLElement;
    if (to) {
      btn.href = to;
      btn.hidden = false;
      location.href = to;
    } else {
      msg.textContent = 'Nothing to open.';
    }
  </script>
</Base>

<style>
  .open { max-width: 640px; padding-block: 64px; display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .big { width: 100%; min-height: 72px; font-size: 22px; }
  [hidden] { display: none !important; }
</style>
