---
import Mole from './Mole.astro';
---

<section class="wrap section" id="creador" aria-labelledby="creador-title">
  <div class="card creator">
    <div class="art"><Mole size={160} label="El Topo de OpenMosh" /></div>
    <div class="text">
      <span class="eyebrow">// el creador</span>
      <h2 class="section-title" id="creador-title">Creado por Soquel</h2>
      <p class="lead">Desarrollador que quería aprobar a sus agentes desde el teléfono sin depender de la nube.</p>
      <div class="links">
        <a class="btn" href="https://github.com/lesquel" rel="me noopener">GitHub · lesquel</a>
        <a class="btn" href="https://www.youtube.com/@soquel_" rel="me noopener">YouTube · @soquel_</a>
      </div>
    </div>
  </div>
</section>

<style>
  .creator { display: flex; flex-wrap: wrap; align-items: center; gap: 32px; padding: clamp(26px, 4vw, 44px); }
  .art { flex: none; display: grid; place-items: center; }
  .text { flex: 1 1 320px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  @media (max-width: 640px) { .creator { justify-content: center; text-align: center; } .links { justify-content: center; } }
</style>
