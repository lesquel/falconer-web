---
const agents = [
  { name: 'Claude Code' },
  { name: 'Codex' },
  { name: 'Gemini CLI' },
  { name: 'Cursor' },
  { name: 'GitHub Copilot CLI' },
  { name: 'Kiro' },
  { name: 'OpenCode' },
  { name: 'Aider' },
  { name: 'Pi', note: 'vía adjuntos' },
  { name: 'Amp', note: 'aprobaciones' },
];
---

<section class="wrap section" id="agentes" aria-labelledby="agentes-title">
  <div class="section-head center">
    <span class="eyebrow">// agentes compatibles</span>
    <h2 class="section-title" id="agentes-title">Tu agente de siempre.</h2>
    <p class="lead">OpenMosh no te casa con ninguno. Usá el que ya usás.</p>
  </div>
  <ul class="chips mono">
    {agents.map((a) => (
      <li>{a.name}{a.note && <small> · {a.note}</small>}</li>
    ))}
  </ul>
</section>

<style>
  .chips { list-style: none; margin: 0 auto; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; max-width: 900px; }
  li { padding: 12px 18px; border-radius: 999px; border: 1px solid var(--line-strong); background: var(--surface); font-size: 14px; }
  li:hover { border-color: var(--accent); }
  small { color: var(--dim); font-size: 12px; }
</style>
