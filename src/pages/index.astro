---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import About from '../components/About.astro';
import Problem from '../components/Problem.astro';
import Steps from '../components/Steps.astro';
import Bento from '../components/Bento.astro';
import Agents from '../components/Agents.astro';
import Security from '../components/Security.astro';
import Compare from '../components/Compare.astro';
import Creator from '../components/Creator.astro';
import OpenSource from '../components/OpenSource.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Falconer · Tus agentes, en tu bolsillo"
  description="Terminal móvil gratis y de código abierto para tus agentes de IA: notificaciones cifradas y aprobaciones en un toque, desde tu propia máquina."
>
  <div class="backdrop" aria-hidden="true"></div>
  <Header />
  <main>
    <Hero />
    <Marquee />
    <About />
    <Problem />
    <Steps />
    <Bento />
    <Agents />
    <Security />
    <Compare />
    <Creator />
    <OpenSource />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/interactions';
</script>

<style>
  .backdrop {
    pointer-events: none;
    position: absolute;
    inset: 0;
    min-height: 100%;
    background:
      radial-gradient(520px circle at var(--mx) var(--my), color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px) 0 0 / 56px 56px;
  }
  main { position: relative; }
</style>
