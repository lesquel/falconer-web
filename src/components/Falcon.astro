---
/** The Falconer falcon: the app icon artwork (public/falconer-320.webp). */
interface Props {
  size?: number;
  label?: string;
}

const { size = 190, label = 'El halcón de Falconer' } = Astro.props;
---

<img src="/falconer-320.webp" width={size} height={size} alt={label} loading="lazy" decoding="async" />
