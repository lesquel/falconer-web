---
import InstallCommand from './InstallCommand.astro';
import Mole from './Mole.astro';
---

<section class="wrap section" id="descargar" aria-labelledby="cta-title">
  <div class="cta">
    <Mole size={110} label="El Topo te espera" />
    <h2 class="section-title" id="cta-title">Llevate tus agentes<br /><span>en el bolsillo.</span></h2>
    <a class="btn primary big" href="https://github.com/lesquel/openmosh-app/releases/latest">Descargar APK</a>
    <span class="hint mono">y en tu computadora:</span>
    <InstallCommand />
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    padding: clamp(36px, 6vw, 72px) clamp(20px, 4vw, 48px);
    border-radius: calc(var(--radius) + 8px);
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(600px circle at 50% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      var(--surface);
  }
  .big { font-size: 18px; padding: 18px 30px; }
  .hint { font-size: 12px; color: var(--dim); }
</style>
